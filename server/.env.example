# ── Copiar a .env (local) o cargar en el panel de Render. NUNCA commitear valores reales. ──
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://usuario:clave@localhost:5432/serafina
DATABASE_SSL=false                    # true si la URL de Render es externa (la interna no lo requiere)

# URLs (producción: PENDIENTES de definir según el dominio final; el arranque falla si faltan)
PUBLIC_URL=http://localhost:8080      # sitio público (Netlify)
API_URL=http://localhost:3000         # este backend
ADMIN_URL=http://localhost:3000/admin # panel
TRUST_PROXY=false                     # true detrás de proxy/Render (default true en producción)

# Sesiones / seguridad
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_WINDOW_MS=60000
ARGON_MEMORY_KIB=65536

# Archivos (object storage compatible con S3: Cloudflare R2, Backblaze B2, AWS S3, etc.)
STORAGE_DRIVER=none                   # none | s3  (memory solo para tests)
UPLOAD_MAX_BYTES=8388608
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=                   # base pública (CDN/bucket público) para archivos públicos

# Integraciones (todas opcionales; sin credenciales el sistema funciona y las muestra como "no configuradas")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GA4_PROPERTY_ID=
GSC_SITE_URL=
GBP_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
IG_BUSINESS_ID=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
